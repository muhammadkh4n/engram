{
  "name": "@engram-mem/core",
  "version": "0.6.4",
  "description": "Cognitive memory engine for AI agents — episodic, semantic, procedural memory with consolidation",
  "keywords": [
    "memory",
    "ai",
    "agents",
    "cognitive",
    "embeddings",
    "recall",
    "consolidation",
    "episodic",
    "semantic"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
